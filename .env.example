# Server
PORT=5000
# Bind all interfaces so Android devices on the same LAN can reach the API.
HOST=0.0.0.0
NODE_ENV=development
# Set to 1 only when deployed behind one trusted reverse proxy.
TRUST_PROXY=

# MongoDB
MONGODB_URI=mongodb://localhost:27017/bdmtiles

# Pending-approval inventory reservation expiry
APPROVAL_RESERVATION_TTL_HOURS=24
RESERVATION_EXPIRY_SCHEDULER_ENABLED=true
RESERVATION_EXPIRY_SCHEDULE=*/5 * * * *
RESERVATION_EXPIRY_BATCH_SIZE=100
RESERVATION_EXPIRY_LEASE_SECONDS=300
RESERVATION_EXPIRY_RUN_ON_START=true

# Authentication
JWT_SECRET=replace_with_a_long_random_access_token_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_token_secret
JWT_EXPIRE=15m
JWT_REFRESH_DAYS=30
MAX_REFRESH_SESSIONS=5
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=20
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_RATE_LIMIT_WINDOW_MINUTES=15
PASSWORD_RESET_RATE_LIMIT_MAX=10
# Never enable this outside local development.
ALLOW_DEV_RESET_TOKEN=false

# CORS (comma-separated frontend origins)
FRONTEND_URL=http://localhost:5173

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# SMS Gateway (placeholder)
SMS_API_KEY=
SMS_SENDER_ID=BDMTLS

# Email (leave blank to disable password reset email delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Cloudinary (production file storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Default branch used by the one-time `npm run migrate:branches` backfill
DEFAULT_BRANCH_CODE=MAIN
DEFAULT_BRANCH_NAME=Main Branch
DEFAULT_BRANCH_LEGAL_NAME=BDM GRANIMARMO PRIVATE LIMITED
DEFAULT_BRANCH_GSTIN=
DEFAULT_BRANCH_PAN=
DEFAULT_BRANCH_ADDRESS=
DEFAULT_BRANCH_CITY=
DEFAULT_BRANCH_STATE=Karnataka
DEFAULT_BRANCH_STATE_CODE=29
DEFAULT_BRANCH_PIN_CODE=
DEFAULT_BRANCH_PHONE=
DEFAULT_BRANCH_EMAIL=
