# BDMTILES Backend environment.
#
# Every variable the code actually reads is listed here, with the default the code
# falls back to when the variable is absent. Copy to .env and fill in the secrets.
#
# Verified against the source with:
#   grep -roh "process\.env\.[A-Z0-9_]*" --include=*.js . | sort -u
# plus the dynamic numberFromEnv('NAME', default) lookups in routes/authRoutes.js
# and routes/dealerAuthRoutes.js.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
# Bind all interfaces so Android devices on the same LAN can reach the API.
HOST=0.0.0.0
NODE_ENV=development
# Only set when deployed behind exactly one trusted reverse proxy. An integer is
# read as a hop count; anything else is handed to Express as-is. Leave blank
# locally, or rate limiting can be bypassed with a spoofed X-Forwarded-For.
TRUST_PROXY=

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/bdmtiles

# ── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_access_token_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_token_secret
# NOTE: JWT_EXPIRE is NOT read. The access-token lifetime is hardcoded to 15m in
# utils/jwt.js. Change it there, not here.
JWT_EXPIRE=15m
JWT_REFRESH_DAYS=30
MAX_REFRESH_SESSIONS=5
PASSWORD_MIN_LENGTH=10
# Seconds a just-rotated refresh token is still honoured, so two browser tabs (or
# a burst of parallel requests) refreshing at almost the same moment both get a
# valid session instead of one of them being logged out as a false "reuse".
REFRESH_ROTATION_GRACE_SECONDS=10
# Dealer app and storefront customer session lifetimes.
DEALER_TOKEN_EXPIRY=30d
CUSTOMER_JWT_EXPIRE=30d

# ── Staff login hardening ────────────────────────────────────────────────────
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=20

# ── Password reset ───────────────────────────────────────────────────────────
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_RATE_LIMIT_WINDOW_MINUTES=15
PASSWORD_RESET_RATE_LIMIT_MAX=10
# Returns the reset token in the API response. Only honoured when
# NODE_ENV=development. Never enable this on a deployed environment.
ALLOW_DEV_RESET_TOKEN=false

# ── OTP (staff + dealer app login) ───────────────────────────────────────────
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
# SECURITY: defaults to TRUE when absent, which returns the OTP in the API
# response body. Convenient locally with no SMS gateway; MUST be false in
# staging and production or anyone can log in as any dealer.
OTP_EXPOSE_CODE=false
OTP_REQUEST_RATE_LIMIT_WINDOW_MINUTES=15
OTP_REQUEST_RATE_LIMIT_MAX=12
OTP_VERIFY_RATE_LIMIT_WINDOW_MINUTES=15
OTP_VERIFY_RATE_LIMIT_MAX=20
DEALER_OTP_REQUEST_WINDOW_MINUTES=15
DEALER_OTP_REQUEST_MAX=12
DEALER_OTP_VERIFY_WINDOW_MINUTES=15
DEALER_OTP_VERIFY_MAX=20

# ── Storefront customer OTP ──────────────────────────────────────────────────
# SECURITY: defaults to '1234' when absent and accepts it for every customer.
# Leave it EMPTY (as below) to force a random OTP. A real SMS provider still
# needs wiring into utils/customerOtp.js before production.
CUSTOMER_OTP_FIXED=

# ── Inventory reservation expiry ─────────────────────────────────────────────
# Hours a pending-approval sales order holds its reservation. 0 = never expires.
APPROVAL_RESERVATION_TTL_HOURS=24
# Hours an unpaid online order holds stock before it is auto-cancelled.
ONLINE_RESERVATION_TTL_HOURS=48
RESERVATION_EXPIRY_SCHEDULER_ENABLED=true
RESERVATION_EXPIRY_SCHEDULE=*/5 * * * *
RESERVATION_EXPIRY_BATCH_SIZE=100
# Minimum enforced by the code is 30 seconds.
RESERVATION_EXPIRY_LEASE_SECONDS=300
RESERVATION_EXPIRY_RUN_ON_START=true

# ── Storefront branch ────────────────────────────────────────────────────────
# Branch online orders and public stock lookups are posted against. Must be the
# ObjectId of an active branch. If blank or not found, utils/onlineBranch.js
# silently falls back to the OLDEST active branch — set this explicitly before
# going live so storefront stock is not drawn from the wrong branch.
ONLINE_BRANCH_ID=

# ── Reporting timezone ───────────────────────────────────────────────────────
# Offset used when bucketing SE attendance/visits into business days. 330 = IST.
BUSINESS_TZ_OFFSET_MINUTES=330

# ── CORS (comma-separated frontend origins) ──────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Email (password reset delivery) ──────────────────────────────────────────
# services/mailService.js only sends when HOST, PORT, USER and PASS are all set;
# otherwise reset emails are skipped silently. Port 465 switches on TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Falls back to SMTP_USER when blank.
MAIL_FROM=

# ── One-time branch backfill (npm run migrate:branches) ──────────────────────
# Read only by scripts/migrateMultiBranch.js. Ignored during normal operation.
DEFAULT_BRANCH_CODE=MAIN
DEFAULT_BRANCH_NAME=Main Branch
DEFAULT_BRANCH_LEGAL_NAME=BDM GRANIMARMO PRIVATE LIMITED
DEFAULT_BRANCH_GSTIN=
DEFAULT_BRANCH_PAN=
DEFAULT_BRANCH_ADDRESS=
DEFAULT_BRANCH_CITY=
DEFAULT_BRANCH_STATE=Karnataka
DEFAULT_BRANCH_STATE_CODE=29
DEFAULT_BRANCH_PIN_CODE=
DEFAULT_BRANCH_PHONE=
DEFAULT_BRANCH_EMAIL=

# ─────────────────────────────────────────────────────────────────────────────
# NOT READ BY ANY CODE — previously listed here but no longer, to avoid implying
# they do something:
#   UPLOAD_DIR / MAX_FILE_SIZE  middleware/upload.js hardcodes the directories
#                               (uploads/, private-uploads/) and a per-type size
#                               limit (5MB images, 8MB credit notes, 25MB
#                               complaint evidence, 100MB web video).
#   SMS_API_KEY / SMS_SENDER_ID no SMS provider is integrated yet.
#   CLOUDINARY_*                no Cloudinary integration exists; uploads are
#                               written to local disk.
#   JWT_REFRESH_EXPIRE          superseded by JWT_REFRESH_DAYS.
# ─────────────────────────────────────────────────────────────────────────────

# ── Quotation stock holds ────────────────────────────────────────────────────
# An approved quotation can hold real stock (Stock.availableQty -> quotedQty) so
# that converting it to a Sales Order can never fail on stock. The hold MUST
# expire, otherwise unconverted quotations keep inventory unsellable forever and
# anyone could freeze the warehouse just by raising quotations.
# Hours a hold survives. 0 disables expiry entirely (not recommended).
QUOTATION_HOLD_TTL_HOURS=72
# Sweeper that releases lapsed holds. Expiry is gentle: the quotation keeps its
# status and its FIFO position, it only loses the guarantee.
QUOTATION_HOLD_EXPIRY_SCHEDULER_ENABLED=true
QUOTATION_HOLD_EXPIRY_SCHEDULE=*/15 * * * *
QUOTATION_HOLD_EXPIRY_BATCH_SIZE=100
# Minimum enforced by the code is 30 seconds.
QUOTATION_HOLD_EXPIRY_LEASE_SECONDS=300
QUOTATION_HOLD_EXPIRY_RUN_ON_START=false
