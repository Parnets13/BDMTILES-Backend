{
  "name": "bdmtiles-backend",
  "version": "1.0.0",
  "description": "BDMTILES All-in-One Business Management Platform - Backend API",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
    "create-admin": "node scripts/createSuperAdmin.js",
    "migrate:branches": "node scripts/migrateMultiBranch.js",
    "migrate:quotation-conversions": "node scripts/migrateQuotationConversions.js --dry-run",
    "migrate:quotation-conversions:execute": "node scripts/migrateQuotationConversions.js --execute",
    "migrate:quotation-readiness": "node scripts/migrateQuotationReadiness.js --dry-run",
    "migrate:quotation-readiness:execute": "node scripts/migrateQuotationReadiness.js --execute",
    "validate:quotation-readiness": "node scripts/validateQuotationReadinessScenarios.js",
    "validate:dealer-permissions": "node scripts/validateDealerPermissions.mjs",
    "validate:dealer-flow": "node scripts/validateDealerEmployeeFlow.mjs",
    "migrate:stock-movements": "node scripts/migrateStockMovements.js --dry-run",
    "migrate:stock-movements:execute": "node scripts/migrateStockMovements.js --execute",
    "migrate:uom-lineage": "node scripts/migrateUomLineage.js --dry-run",
    "migrate:uom-lineage:execute": "node scripts/migrateUomLineage.js --execute",
    "migrate:delivery-lineage": "node scripts/migrateDeliveryItemLineage.js --dry-run",
    "migrate:delivery-lineage:execute": "node scripts/migrateDeliveryItemLineage.js --execute",
    "test:modules": "node scripts/testAllModules.js"
  },
  "keywords": [
    "bdmtiles",
    "erp",
    "crm",
    "tiles"
  ],
  "author": "BDMTILES",
  "license": "PROPRIETARY",
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.2",
    "mongoose-paginate-v2": "^1.9.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.1",
    "pdfkit": "^0.17.2",
    "sharp": "^0.35.4",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.3"
  }
}
