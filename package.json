{
  "name": "bdmtiles-backend",
  "version": "1.0.0",
  "description": "BDMTILES All-in-One Business Management Platform - Backend API",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node --use-system-ca server.js",
    "dev": "nodemon server.js",
    "seed": "node --use-system-ca scripts/seed.js",
    "create-admin": "node --use-system-ca scripts/createSuperAdmin.js",
    "migrate:branches": "node --use-system-ca scripts/migrateMultiBranch.js",
    "migrate:quotation-conversions": "node --use-system-ca scripts/migrateQuotationConversions.js --dry-run",
    "migrate:quotation-conversions:execute": "node --use-system-ca scripts/migrateQuotationConversions.js --execute",
    "migrate:quotation-readiness": "node --use-system-ca scripts/migrateQuotationReadiness.js --dry-run",
    "migrate:quotation-readiness:execute": "node --use-system-ca scripts/migrateQuotationReadiness.js --execute",
    "validate:quotation-readiness": "node --use-system-ca scripts/validateQuotationReadinessScenarios.js",
    "migrate:stock-movements": "node --use-system-ca scripts/migrateStockMovements.js --dry-run",
    "migrate:stock-movements:execute": "node --use-system-ca scripts/migrateStockMovements.js --execute",
    "migrate:uom-lineage": "node --use-system-ca scripts/migrateUomLineage.js --dry-run",
    "migrate:uom-lineage:execute": "node --use-system-ca scripts/migrateUomLineage.js --execute",
    "migrate:delivery-lineage": "node --use-system-ca scripts/migrateDeliveryItemLineage.js --dry-run",
    "migrate:delivery-lineage:execute": "node --use-system-ca scripts/migrateDeliveryItemLineage.js --execute",
    "test:modules": "node --use-system-ca scripts/testAllModules.js"
  },
  "keywords": [
    "bdmtiles",
    "erp",
    "crm",
    "tiles"
  ],
  "author": "BDMTILES",
  "license": "PROPRIETARY",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.2",
    "mongoose-paginate-v2": "^1.9.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.1",
    "pdfkit": "^0.17.2",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
